node_modules/
# Every env file EXCEPT the checked-in examples. `.env` and `.env.local` alone
# left .env.production — the one that holds real production secrets — tracked.
.env
.env.*
!.env.example
!.env.production.example

# Uploaded avatars, logos and documents when storage is on local disk. User
# content, not source.
uploads/
backend/uploads/

# Let's Encrypt material created on the server by deploy/issue-cert.sh.
deploy/certbot/
dist/
build/
.DS_Store
*.log

# Local machine settings — the shared config lives in .claude/settings.json
.claude/settings.local.json

# Vite / test output
.vite/
coverage/
playwright-report/
test-results/
scripts/

# …except the world-map generator. public/map/world.json is generated and
# committed so the build stays offline; the script that produces it has to be
# committed alongside it or that data becomes unreproducible. Git cannot
# re-include a file inside an excluded directory, hence un-ignoring the
# directory first and then everything in it but this one file.
!frontend/scripts/
frontend/scripts/*
!frontend/scripts/build-world-map.mjs
!frontend/scripts/build-boarding-path.mjs
