generator client {
  provider      = "prisma-client-js"
  // This tree lives on a Windows drive but is also worked on from WSL, so the
  // client has to carry both engines. Generating for one platform only makes
  // every query fail on the other with "could not locate the Query Engine".
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Indexing note
//
// The first migration created 6 foreign keys and 0 indexes. Postgres, unlike
// MySQL, does NOT index a foreign key column automatically, so every
// `where: { agentId }`, every `institution: { country: { code } }` join and
// every `orderBy: { createdAt: 'desc' }` was a sequential scan. Each @@index
// below backs a query the app actually issues.
// ============================================================================

enum Role {
  SUPER_ADMIN
  ADMIN
  AGENT
  STUDENT
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(AGENT)
  // When false the account exists but login is refused.
  isActive     Boolean  @default(true)
  // Optional profile fields — all roles can fill these in.
  phone        String?
  bio          String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Sub-agents: the header in the reference screenshots has an "invite
  // sub-agent" action. This was a bare `parentAgentId String?` with no relation,
  // so nothing stopped it pointing at a non-existent user.
  parentAgentId String?
  parentAgent   User?   @relation("AgencyHierarchy", fields: [parentAgentId], references: [id], onDelete: SetNull)
  subAgents     User[]  @relation("AgencyHierarchy")

  applications      Application[]
  // Documents this user attached to an application. Named for the action rather
  // than the object, because `documents` on a User would read as "their files"
  // and these belong to an application.
  uploadedDocuments ApplicationDocument[]
  courseInquiries   CourseInquiry[]
  refreshTokens     RefreshToken[]
  passwordResets    PasswordResetToken[]
  notifications     Notification[]
  studentProfile    StudentProfile?
  agencyProfile     AgencyProfile?

  @@index([parentAgentId])
  @@index([role])
  // The admin user list orders by this.
  @@index([createdAt])
}

// Password reset. Same discipline as RefreshToken: only the SHA-256 of the token
// is stored, so a database dump does not hand over the ability to take over
// accounts. Single-use (usedAt) and short-lived (expiresAt) because a reset link
// is a bearer credential that arrives over email and lives in an inbox
// indefinitely.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum RefreshRevokeReason {
  ROTATED // superseded by a newer token during a normal refresh
  LOGOUT // the user deliberately ended this session
  REPLAY // revoked as collateral when a rotated token was replayed
}

model RefreshToken {
  id            String               @id @default(uuid())
  userId        String
  // SHA-256 of the token, never the token itself: a leaked database dump then
  // does not hand over live sessions.
  tokenHash     String               @unique
  expiresAt     DateTime
  revokedAt     DateTime?
  // Why it was revoked matters. Only a ROTATED token being presented again
  // implies theft — that token was replaced, so whoever still holds it either
  // raced us or stole it, and revoking every session is the right response.
  // A LOGOUT token being presented again is mundane (a stale tab retrying) and
  // must NOT take down the user's other devices.
  revokedReason RefreshRevokeReason?
  createdAt     DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================================
// Agency profile — set by a top-level AGENT to brand their portal.
// Sub-agents inherit their parent's AgencyProfile (resolved in the service).
// logoUrl is an opaque URL so storage backends can be swapped without migration.
// ============================================================================
model AgencyProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  agencyName  String
  logoUrl     String?
  website     String?
  // Hex color extracted from the logo (or manually chosen) that drives the
  // full --accent-* scale for this agent's portal. e.g. "#C96E0E"
  // NULL means the default NV Immigration orange is used.
  accentColor String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================================
// Student profile — extra fields that only students have.
// ============================================================================
model StudentProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  nationality String?
  dateOfBirth DateTime?
  passportNo  String?
  phone       String?
  address     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================================
// Reference data
// ============================================================================

model Country {
  id   String @id @default(uuid())
  name String
  code String @unique // "UK", "CA", "AU" — matches the country-strip chips

  // The header strip rendered 15 hardcoded text chips while the database held 4
  // rows and no flags, so 11 of them silently returned nothing.
  flagEmoji    String?
  // ISO 3166-1 alpha-2, e.g. "GB". Explicit rather than reverse-engineered from
  // flagEmoji's Regional Indicator code points, and deliberately separate from
  // `code` — the portal's own shorthand is NOT ISO (we use UK, GR, SP, UAE, IR,
  // NE where ISO says GB, DE, ES, AE, IE, NL). Flags are keyed on this.
  isoCode      String?
  // Fees were printed as "$X CAD" for every course regardless of destination;
  // the reference screenshots show GBP for UK institutions. Currency belongs to
  // the country rather than the course — tuition for two courses in the same
  // country is not quoted in different currencies.
  currencyCode String   @default("USD")
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  institutions     Institution[]
  courseInquiries  CourseInquiry[]
  importantUpdates ImportantUpdate[]
  documents        Document[]

  @@index([sortOrder])
}

model Institution {
  id            String    @id @default(uuid())
  name          String
  // URL-safe slug used in deep-links and the `school.slug` field in the program
  // response. Derived from the institution name on creation.
  slug          String    @unique
  countryId     String
  // Province / state — shown alongside the city in the school object.
  province      String?
  // City moved here from Course: a campus has one city; courses inherit it.
  city          String?
  isBlacklisted Boolean   @default(false)
  logoUrl       String?
  // Banner / hero image for the school page. Nullable: only ~60% of schools
  // have one upstream.
  bannerUrl     String?
  // Upstream id, scoped by `source`. Nullable so hand-created rows stay valid.
  // Unique on its own is wrong once there is more than one feed: Catalogue B
  // university 116 is Otago Polytechnic while Catalogue A 116 is SUNY
  // Fulton-Montgomery, so the pair is what identifies a row. See @@unique below.
  externalId    Int?
  // Which feed a row came from. "manual" means a human created it and no
  // importer should overwrite it.
  source        String    @default("manual")
  // Drives the "Trending Universities" carousel on the Report screen.
  isTrending    Boolean   @default(false)
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  country           Country               @relation(fields: [countryId], references: [id])
  courses           Course[]
  moiAcceptances    MoiAcceptance[]
  commission        UniversityCommission?
  entryRequirements EntryRequirement[]
  importantUpdates  ImportantUpdate[]
  documents         Document[]
  photos            SchoolPhoto[]
  aliases           InstitutionAlias[]

  @@unique([source, externalId])
  @@index([countryId])
  @@index([isBlacklisted])
  @@index([isTrending])
  @@index([archivedAt])
  @@index([source])
}

// Structured program-level enum so the dashboard can filter and the response
// can emit the machine-readable identifiers the target API uses.
enum ProgramLevel {
  MASTERS_DEGREE
  POST_GRADUATE_CERTIFICATE
  DIPLOMA
  CERTIFICATE
  BACHELORS_DEGREE
  THREE_YEAR_BACHELORS
  FOUR_YEAR_BACHELORS
  FOUNDATION
  // Added for the Catalogue A import: these are real categories students filter
  // on, and without them ~4,800 programs would collapse into OTHER.
  INTEGRATED_MASTERS
  POST_GRADUATE_DIPLOMA
  ADVANCED_DIPLOMA
  DOCTORAL_PHD
  TOPUP_DEGREE
  ENGLISH
  NON_CREDENTIAL
  SECONDARY_SCHOOL
  OTHER
}

// Structured success-score intent enum.
enum SuccessScoreIntent {
  positive
  negative
  neutral
}

// A feed identity that has been merged into another institution.
//
// The catalogue carries the same university under two rows whenever both feeds
// list it — one (catalogue_a, 269) and one (catalogue_b, 169) for Acadia, say.
// Merging them deletes one row, but the importer resolves a school by
// (source, externalId) and CREATES when that misses, so the next sync of the
// losing feed simply rebuilt the duplicate and moved its courses back. Merges
// silently undid themselves.
//
// A merge now leaves this forwarding address behind: the importer looks here
// before creating, finds the surviving institution, and attaches that feed's
// courses and photos to it. The row is the feed's identity, so the primary key
// is the same (source, externalId) pair the importer searches on.
//
// Cascade: if the surviving institution is later deleted, its forwarding
// addresses are meaningless and go with it — the next import then re-creates a
// row from the feed, which is the correct fallback.
model InstitutionAlias {
  source        String
  externalId    Int
  institutionId String
  // Why the merge happened, for whoever reads this table in a year.
  note          String?
  createdAt     DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@id([source, externalId])
  @@index([institutionId])
}

model Course {
  id            String @id @default(uuid())
  institutionId String

  // Upstream id, scoped by `source` — see the note on Institution.externalId.
  externalId Int?
  source     String @default("manual")

  // The provider's own link to the university's course page. Catalogue A does
  // not publish one; Catalogue B does, and agents use it to check details the
  // feed does not carry.
  externalUrl String?

  // Entry requirements as published by the feed: IELTS/PTE/TOEFL/Duolingo
  // bands, academic score, accepted tests, MOI. Json rather than columns
  // because the shape is irregular per provider and per course — some carry
  // "No", some "6.5", some nothing — and a dozen nullable columns would encode
  // one provider's format as the schema.
  entryRequirements Json?

  // Human-readable full name, e.g. "Master of Science - Computational Sciences (Course)"
  title        String
  // Short display name shown on cards, e.g. "Computational Sciences"
  shortName    String?
  // URL-safe slug for deep-links, e.g. "master-of-science-computational-sciences-course"
  slug         String       @unique
  // Replaces the free-text `degreeLevel` — machine-readable enum for grouping/filtering
  programLevel ProgramLevel @default(OTHER)

  // Duration in calendar months (replaces the freeform `durationText` string).
  // minLength == maxLength means a fixed-length programme.
  minLength Int @default(0)
  maxLength Int @default(0)

  // ISO 639-3 language code, e.g. "eng"
  languageOfInstruction String @default("eng")

  tuitionFee     Decimal
  // Nullable because "no fee published" and "no fee charged" are different
  // answers, and an agent acting on the wrong one quotes a student the wrong
  // price. Catalogue B publishes a fee on about 4% of its courses; Catalogue A
  // publishes one on all of its, including genuine zeroes.
  applicationFee Decimal?

  // ISO 4217 for tuitionFee, when the feed publishes one per course. Country
  // carries a currencyCode and is the fallback, but it is not always right:
  // De Montfort University Dubai is a UK institution quoting AED, Lincoln
  // University (New Zealand) is filed under the UK and quotes NZD, and
  // academyEX quotes USD in New Zealand. Null means "use the country's".
  currencyCode String?

  // Convenience pre-computed commission amount (highest tier) stored alongside
  // the structured commission object so the card can show it without a join.
  commissionAmount Decimal?

  // Whether this program supports the aggregator app creation flow.
  abAppCreationEnabled Boolean @default(false)

  // Success score shown on the program card.
  successScoreIntent SuccessScoreIntent?
  successScoreLabel  String?

  // Months this course recurs in, 1-12, with no year. Most courses run on a
  // fixed cycle -- "every February and September" -- and that fact does not
  // expire, so it is stored once instead of as a row per year that has to be
  // re-entered each intake season. CourseIntake still holds dated instances
  // where a provider publishes a real start or deadline; the two answer
  // different questions and only one of them goes stale.
  intakeMonths Int[]

  tags   String[] // ["top_programs", "popular_programs", "high_job_availability", ...]
  // Display pills e.g. "Instant Offer", "Instant Submission"
  badges String[]

  // Soft delete — applications must keep resolving their course after withdrawal.
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  institution  Institution    @relation(fields: [institutionId], references: [id])
  intakes      CourseIntake[]
  applications Application[]

  @@unique([source, externalId])
  @@index([institutionId])
  @@index([programLevel])
  @@index([archivedAt])
  @@index([createdAt])
  @@index([slug])
  @@index([source])
}

// Replaces the `intakes String[]` array. Each intake now has its own identity,
// dates and scoring data to match the programIntakes shape in the target API.
model CourseIntake {
  id                 Int       @id @default(autoincrement())
  courseId           String
  startDate          DateTime
  openDate           DateTime?
  submissionDeadline DateTime?
  overallScore       Float?
  // scoreDetails is irregular in structure so it stays Json.
  scoreDetails       Json      @default("[]")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([startDate])
}

model MoiAcceptance {
  id            String   @id @default(uuid())
  institutionId String
  courseType    String
  years         Int
  documentUrl   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  // One record per (institution, course type). Duplicates already split the
  // agent-facing dropdown into two options for the same award.
  @@unique([institutionId, courseType])
  @@index([institutionId])
  @@index([courseType])
}

// Commission structure per institution. `tiers` (legacy freeform) is preserved
// for backward compat with the Commission screen. The typed fields below are
// used by the program/dashboard API to build the structured commission object.
model UniversityCommission {
  id            String @id @default(uuid())
  institutionId String @unique

  // Legacy freeform tiers array for the Commission screen display.
  // e.g. [{ label: "1-5 Students", rate: "15%" }, ...]
  tiers Json

  // Structured fields for the program response commission object.
  commissionType          String? // "percentage" | "fixed_amount"
  rateFrom                Float?
  rateTo                  Float?
  amountFrom              Decimal?
  amountTo                Decimal?
  isTierAdjusted          Boolean  @default(false)
  maxNumberOfInstallments Int?
  tuitionBasis            String? // "net" | "gross"

  notes      String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  // Every list on this model filters on archivedAt.
  @@index([archivedAt])
}

enum StudyLevel {
  UG
  PG
}

// Images 3 and 4 — the UG and PG Entry Requirements tables. One row per
// institution per level; the two screens are the same component with a
// different `level`.
model EntryRequirement {
  id                   String     @id @default(uuid())
  institutionId        String
  level                StudyLevel
  englishRequirement   String
  academicRequirement  String
  offerTimeline        String // "48 to 72 hours", "1 Week"
  credibilityInterview Boolean    @default(false)
  financialInformation String
  archivedAt           DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, level])
  @@index([level])
  @@index([credibilityInterview])
  // Every list on this model filters on archivedAt.
  @@index([archivedAt])
}

// Images 5 and 6 — Important Updates, filtered by publish date, country and
// institution. attachmentUrl drives the download icon, which the screenshots
// show on some rows and not others.
model ImportantUpdate {
  id            String    @id @default(uuid())
  title         String
  body          String
  publishDate   DateTime
  countryId     String?
  institutionId String?
  attachmentUrl String?
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  country     Country?     @relation(fields: [countryId], references: [id], onDelete: SetNull)
  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  @@index([publishDate])
  @@index([countryId])
  @@index([institutionId])
  // Every list on this model filters on archivedAt.
  @@index([archivedAt])
}

enum DocumentCategory {
  VISA_DOCUMENT
  REFUND_FORM
  INSTITUTE_BROCHURE
  SOP
  LOR
}

// Images 7 to 18 — all five Document Bank screens are this one table filtered by
// category. `fileUrl` is deliberately an opaque string rather than a storage key
// or a path, so switching between local disk and S3/R2 presigned URLs later is a
// service-layer change and not a migration.
model Document {
  id            String           @id @default(uuid())
  category      DocumentCategory
  title         String
  fileUrl       String
  /// First page of the PDF, rendered once on upload. Nullable because it is
  /// best-effort: a file poppler cannot draw still uploads, and the grid falls
  /// back to the typed tile. Same shape as SchoolPhoto.thumbnailUrl.
  thumbnailUrl  String?
  countryId     String?
  institutionId String?
  sortOrder     Int              @default(0)
  archivedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  country     Country?     @relation(fields: [countryId], references: [id], onDelete: SetNull)
  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  // Composite: every Document Bank screen queries by category first, then
  // narrows by country and institution.
  @@index([category, countryId, institutionId])
  @@index([category, sortOrder])
  // Every list on this model filters on archivedAt.
  @@index([archivedAt])
}

// Image 21 — the Help & Support contact cards.
model SupportContact {
  id         String    @id @default(uuid())
  name       String
  phone      String
  avatarUrl  String?
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([sortOrder])
  // Every list on this model filters on archivedAt.
  @@index([archivedAt])
}

// The two banners pinned above every screen in the reference portal: a red
// blacklist warning with a "Click for list" action, and a blue declaration-form
// notice with a download. Modelled rather than hardcoded so ops can change the
// wording without a deploy.
enum AnnouncementVariant {
  DANGER
  INFO
  WARNING
}

model Announcement {
  id        String              @id @default(uuid())
  variant   AnnouncementVariant
  message   String
  ctaLabel  String?
  ctaUrl    String?
  isActive  Boolean             @default(true)
  sortOrder Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([isActive, sortOrder])
}

// The "Useful Informations" panel on the Report screen (empty in image 19, so
// the empty state is a designed state).
model UsefulInformation {
  id         String    @id @default(uuid())
  title      String
  body       String
  linkUrl    String?
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([sortOrder])
  // Every list on this model filters on archivedAt.
  @@index([archivedAt])
}

// ============================================================================
// Agent workflow
// ============================================================================

enum CourseInquiryStage {
  INQUIRY
  PENDING
  OFFERED
  APPLIED
}

model CourseInquiry {
  id          String             @id @default(uuid())
  agentId     String
  nationality String
  countryId   String?
  intake      String?
  courseType  String?
  // Was a free-text `status` defaulting to "open". The Report screen counts
  // inquiries by stage (Course Inquiry / Pending / Offered / Applied), which a
  // free-text column cannot answer without guessing at spellings.
  stage       CourseInquiryStage @default(INQUIRY)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  agent   User     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  // countryId existed with no relation, so it had no referential integrity and
  // the history table could not display a country name.
  country Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)

  @@index([agentId, createdAt])
  @@index([countryId])
  @@index([stage])
}

// The 8 stat tiles across the top of the Report screen, in order. Making this an
// enum is what turns that screen into a single groupBy instead of eight
// hand-counted queries.
/// What an agent attaches to an application: the passport scan, transcripts,
/// the declaration form. Distinct from `Document`, which is the admin-curated
/// Document Bank -- reference material an agent READS (SOP templates, visa
/// checklists, brochures), scoped by category and country rather than owned by
/// anyone. These belong to one application and are written by the agent filing
/// it, which is why they carry an uploader and their own access rules.
model ApplicationDocument {
  id            String                  @id @default(uuid())
  applicationId String
  kind          ApplicationDocumentKind @default(OTHER)
  /// Free text, and the only way to name an OTHER document. Kept alongside the
  /// enum rather than instead of it so the common types stay queryable -- a
  /// "which applications are missing a declaration form" question is the whole
  /// reason this is not just a label.
  label         String?

  fileUrl     String
  /// The name the agent's own machine gave it. Shown in the list, because
  /// "passport_final_v2.pdf" is how they recognise which file they sent, and
  /// the stored key is a uuid that tells them nothing.
  fileName    String
  contentType String
  sizeBytes   Int

  uploadedById String
  /// Soft-deleted, like every other file-bearing model here: an application is a
  /// record of what was submitted, and a removed document is part of that.
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  uploadedBy  User        @relation(fields: [uploadedById], references: [id])

  @@index([applicationId, createdAt])
  @@index([archivedAt])
}

enum ApplicationDocumentKind {
  // 54 values, grouped the way the picker groups them. The first eight are
  // the originals and must keep their names -- production rows carry them.
  // The frontend catalogue in constants/documentKinds.js is the label source;
  // documentKinds.test.js fails if the two drift apart.
  PASSPORT
  PASSPORT_PHOTO
  NATIONAL_ID
  BIRTH_CERTIFICATE
  PREVIOUS_VISA
  VISA_REFUSAL
  TENTH_CERTIFICATE
  TWELFTH_CERTIFICATE
  BACHELORS_DEGREE
  BACHELORS_TRANSCRIPT
  MASTERS_DEGREE
  MASTERS_TRANSCRIPT
  DIPLOMA_CERTIFICATE
  ACADEMIC_TRANSCRIPT
  BACKLOG_CERTIFICATE
  MEDIUM_OF_INSTRUCTION
  GAP_JUSTIFICATION
  ENGLISH_TEST
  IELTS
  PTE
  TOEFL
  DUOLINGO
  STATEMENT_OF_PURPOSE
  LETTER_OF_RECOMMENDATION
  CV_RESUME
  PORTFOLIO
  RESEARCH_PROPOSAL
  EXPERIENCE_LETTER
  PAYSLIP
  INTERNSHIP_CERTIFICATE
  FINANCIAL
  BANK_STATEMENT
  BANK_BALANCE_CERTIFICATE
  LOAN_SANCTION_LETTER
  SPONSORSHIP_AFFIDAVIT
  INCOME_TAX_RETURN
  FIXED_DEPOSIT
  PROPERTY_VALUATION
  SCHOLARSHIP_LETTER
  FEE_RECEIPT
  OFFER_LETTER
  CAS_LETTER
  CONFIRMATION_OF_ENROLMENT
  DECLARATION_FORM
  TB_TEST
  MEDICAL_REPORT
  POLICE_CLEARANCE
  ATAS_CERTIFICATE
  ACCOMMODATION_PROOF
  TRAVEL_INSURANCE
  BIOMETRIC_APPOINTMENT
  MARRIAGE_CERTIFICATE
  NAME_CHANGE_AFFIDAVIT
  OTHER
}

enum ApplicationStage {
  PROFILE_ASSESSMENT
  APPLICATION
  CONDITIONAL_OFFER
  UNCONDITIONAL_OFFER
  FEES_PAYMENT
  CAS_LETTER
  VISA_APPLICATION
  VISA_APPROVAL
}

model Application {
  id          String  @id @default(uuid())
  // The "POEC ID: 4367" the reference portal shows on every application. A
  // sequential integer because agents read these out on the phone; a uuid is not
  // something anyone dictates.
  reference   Int     @unique @default(autoincrement())
  agentId     String
  studentName String
  passportNo  String
  courseId    String
  intakeLabel String? // "March 2027", as displayed alongside the reference

  // Replaces primaryStatus/secondaryStatus. `stage` is the queryable state that
  // drives the Report tiles; `stageNote` keeps the human detail the UI shows on
  // a second line ("Profile Under Review"), which no code needs to interpret.
  stage      ApplicationStage @default(PROFILE_ASSESSMENT)
  stageNote  String?
  deadlineAt DateTime? // "Upcoming Application Deadlines" panel
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  agent         User                  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  course        Course                @relation(fields: [courseId], references: [id])
  notifications Notification[]
  documents     ApplicationDocument[]

  @@index([agentId, createdAt])
  @@index([courseId])
  @@index([stage])
  @@index([deadlineAt])
  @@index([passportNo])
}

// Replaces the derived stub in notifications.service.js, which synthesised a
// single item from a blacklist count. The reference portal shows a bell badge, a
// messages badge, and a "Recent Application Notifications" feed with per-item
// read state — none of which a computed count can express.
enum NotificationKind {
  NEW_APPLICATION
  INFO_QUERY
  DOCUMENT_QUERY
  STAGE_CHANGE
  SYSTEM
}

model Notification {
  id            String           @id @default(uuid())
  userId        String
  applicationId String?
  kind          NotificationKind
  title         String
  body          String
  readAt        DateTime?
  createdAt     DateTime         @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // Backs both the unread badge count and the feed ordering.
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([applicationId])
}

// Gallery photos for a school. A separate table rather than a String[] so each
// photo keeps its upstream id, dimensions and caption, and so a photo can be
// reordered or removed without rewriting the whole array.
model SchoolPhoto {
  id            String @id @default(uuid())
  institutionId String

  // Upstream photo id, scoped by `source` — see Institution.externalId.
  externalId Int?
  source     String @default("manual")

  url          String
  thumbnailUrl String?
  fileName     String?
  contentType  String?
  bytes        Int?
  // Display order within the gallery; ties fall back to createdAt.
  position     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([institutionId])
}
