generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  AGENT
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(AGENT)
  parentAgentId String?
  createdAt    DateTime @default(now())

  applications    Application[]
  courseInquiries CourseInquiry[]
}

model Country {
  id   String @id @default(uuid())
  name String
  code String @unique // "UK", "CA", "AU" — matches the country-strip chips

  institutions Institution[]
}

model Institution {
  id            String   @id @default(uuid())
  name          String
  countryId     String
  isBlacklisted Boolean  @default(false)
  logoUrl       String?

  country Country @relation(fields: [countryId], references: [id])
  courses Course[]
  moiAcceptances MoiAcceptance[]
}

model Course {
  id             String   @id @default(uuid())
  institutionId  String
  title          String
  degreeLevel    String   // "Master's Degree", "Bachelor's Degree", ...
  city           String
  tuitionFee     Decimal
  applicationFee Decimal
  durationText   String   // "12 - 24 months"
  tags           String[] // ["High Job Demand", "Prime", ...]
  status         String[] // ["Instant Offer", "Instant Submission"]
  intakes        String[] // ["Jan 2027", "May 2027", ...]

  institution  Institution   @relation(fields: [institutionId], references: [id])
  applications Application[]
}

model CourseInquiry {
  id          String   @id @default(uuid())
  agentId     String
  nationality String
  countryId   String?
  intake      String?
  courseType  String?
  status      String   @default("open")
  createdAt   DateTime @default(now())

  agent User @relation(fields: [agentId], references: [id])
}

model Application {
  id              String   @id @default(uuid())
  agentId         String
  studentName     String
  passportNo      String
  courseId        String
  primaryStatus   String   // "Application Request"
  secondaryStatus String   // "Profile Under Review"
  createdAt       DateTime @default(now())

  agent  User   @relation(fields: [agentId], references: [id])
  course Course @relation(fields: [courseId], references: [id])
}

model MoiAcceptance {
  id            String  @id @default(uuid())
  institutionId String
  courseType    String
  years         Int
  documentUrl   String?

  institution Institution @relation(fields: [institutionId], references: [id])
}
