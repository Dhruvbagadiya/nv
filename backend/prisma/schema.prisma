generator client {
  provider = "prisma-client-js"
  // This tree lives on a Windows drive but is also worked on from WSL, so the
  // client has to carry both engines. Generating for one platform only makes
  // every query fail on the other with "could not locate the Query Engine".
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  AGENT
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(AGENT)
  parentAgentId String?
  createdAt    DateTime @default(now())

  applications    Application[]
  courseInquiries CourseInquiry[]
  refreshTokens   RefreshToken[]
}

// Refresh tokens are stored (hashed) rather than being stateless, because a
// stateless refresh token cannot be revoked — "log out" would be a client-side
// lie while the token stayed valid for its full 7 days. Rows are also what let
// us detect replay of an already-rotated token.
enum RefreshRevokeReason {
  ROTATED // superseded by a newer token during a normal refresh
  LOGOUT // the user deliberately ended this session
  REPLAY // revoked as collateral when a rotated token was replayed
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  // SHA-256 of the token, never the token itself: a leaked database dump then
  // does not hand over live sessions.
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  // Why it was revoked matters. Only a ROTATED token being presented again
  // implies theft — that token was replaced, so whoever still holds it either
  // raced us or stole it, and revoking every session is the right response.
  // A LOGOUT token being presented again is mundane (a stale tab retrying) and
  // must NOT take down the user's other devices.
  revokedReason RefreshRevokeReason?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Country {
  id   String @id @default(uuid())
  name String
  code String @unique // "UK", "CA", "AU" — matches the country-strip chips

  institutions Institution[]
}

model Institution {
  id            String   @id @default(uuid())
  name          String
  countryId     String
  isBlacklisted Boolean  @default(false)
  logoUrl       String?

  country Country @relation(fields: [countryId], references: [id])
  courses Course[]
  moiAcceptances MoiAcceptance[]
}

model Course {
  id             String   @id @default(uuid())
  institutionId  String
  title          String
  degreeLevel    String   // "Master's Degree", "Bachelor's Degree", ...
  city           String
  tuitionFee     Decimal
  applicationFee Decimal
  durationText   String   // "12 - 24 months"
  tags           String[] // ["High Job Demand", "Prime", ...]
  status         String[] // ["Instant Offer", "Instant Submission"]
  intakes        String[] // ["Jan 2027", "May 2027", ...]

  institution  Institution   @relation(fields: [institutionId], references: [id])
  applications Application[]
}

model CourseInquiry {
  id          String   @id @default(uuid())
  agentId     String
  nationality String
  countryId   String?
  intake      String?
  courseType  String?
  status      String   @default("open")
  createdAt   DateTime @default(now())

  agent User @relation(fields: [agentId], references: [id])
}

model Application {
  id              String   @id @default(uuid())
  agentId         String
  studentName     String
  passportNo      String
  courseId        String
  primaryStatus   String   // "Application Request"
  secondaryStatus String   // "Profile Under Review"
  createdAt       DateTime @default(now())

  agent  User   @relation(fields: [agentId], references: [id])
  course Course @relation(fields: [courseId], references: [id])
}

model MoiAcceptance {
  id            String  @id @default(uuid())
  institutionId String
  courseType    String
  years         Int
  documentUrl   String?

  institution Institution @relation(fields: [institutionId], references: [id])
}
