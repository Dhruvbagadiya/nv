# ---------------------------------------------------------------------------
# LOCAL OVERRIDES: create backend/.env.local for anything specific to your own
# machine — a different NODE_ENV, an extra CORS origin, another database host.
# src/config.js loads it BEFORE this file and dotenv never overwrites a value
# that is already set, so .env.local wins and this file stays deployable as
# written. It is gitignored. Real environment variables beat both.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://user:password@localhost:5432/nv_immigration"

# Both secrets must be >= 32 chars and must not be left as these placeholders —
# src/config.js refuses to boot otherwise. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="replace-with-a-48-byte-random-string-at-least-32-chars"
JWT_REFRESH_SECRET="replace-with-a-different-48-byte-random-string-32chars"

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated allow-list. Never leave this blank: an empty value would make
# CORS reflect any Origin, which combined with credentials:true is exploitable.
CORS_ORIGIN="http://localhost:5173"

# Optional — only needed when API and frontend sit on different subdomains.
# COOKIE_DOMAIN=".example.com"

JSON_BODY_LIMIT=1mb

# --- Running from WSL against a Postgres that lives on the Windows host ---
# "localhost" here resolves inside the WSL VM, not on Windows, so a WSL process
# will not find the server. Two options:
#
# 1. Easiest — run DB-touching commands with the Windows node, which resolves
#    localhost correctly and needs no config change at all:
#      node.exe node_modules/prisma/build/index.js migrate deploy
#      node.exe node_modules/prisma/build/index.js generate
#      node.exe prisma/seed.js
#      node.exe scripts/verify-auth.mjs
#    (`node.exe` is on the PATH inside WSL via /mnt/c/Program Files/nodejs.)
#
# 2. Or open the route: point DATABASE_URL at the WSL gateway (`ip route | grep
#    default`) and allow the subnet through Windows Firewall, from an
#    Administrator PowerShell:
#      New-NetFirewallRule -DisplayName "Postgres from WSL" -Direction Inbound `
#        -LocalPort 5432 -Protocol TCP -Action Allow -RemoteAddress 172.16.0.0/12
#    Postgres also needs a matching pg_hba.conf line for that subnet.
#
# Unrelated but adjacent: `prisma generate` intermittently fails on this mount
# with EPERM/EACCES renaming query_engine-windows.dll.node, because Windows holds
# the file open. Deleting it first (`rm -f
# node_modules/.prisma/client/query_engine-windows.dll.node`) then regenerating
# clears it. It is a filesystem quirk, not a Prisma bug.
#
# Bigger gotcha, same cause: Windows and WSL SHARE this node_modules directory,
# but native modules are per-platform. Whichever side ran `npm install` last wins,
# and the other side then fails with "Cannot find native binding" (rollup,
# rolldown) or "could not locate the Query Engine" (Prisma). Pick one side to
# install from and stick to it; if you must switch, re-run `npm install` there
# first. Prisma is exempt because schema.prisma lists binaryTargets for both.

# --- Document storage (S3 / Cloudflare R2) — optional ---
# Uploads stay disabled until BUCKET, REGION and both keys are present. Leaving
# them unset is a supported state: documents can still be registered by URL.
# S3_BUCKET="nv-immigration-documents"
# S3_REGION="auto"                      # "auto" for R2; a real region for AWS
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"   # R2 only; omit for AWS
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# Where files are SERVED from — not the same host you upload to.
# S3_PUBLIC_BASE_URL="https://files.example.com"
# S3_PRESIGN_TTL_SECONDS=300
