# =============================================================================
# NV Immigration Portal — production environment
#
# Every variable the app reads, enumerated from the Zod schema in src/config.js.
# Anything not listed here is not read. config.js validates at boot, so a missing
# or malformed value fails the deploy with a readable message instead of a 500 on
# someone's first login.
#
# NOTE: COOKIE_SECRET is NOT here. The README lists it as required, but nothing
# reads it — app.js calls cookieParser() with no secret and the schema has no
# such key. Setting it does nothing. The refresh cookie's integrity comes from
# the token being a SHA-256-matched random string, not from cookie signing.
# =============================================================================

# ── Required ─────────────────────────────────────────────────────────────────

NODE_ENV=production
# Controls three things that are all wrong in production if this is not exactly
# "production": the refresh cookie's Secure flag, whether 5xx responses include a
# stack trace, and morgan's log format.

DATABASE_URL=postgresql://user:password@host:5432/nv_immigration_db
# Use the provider's INTERNAL/private host when the app and database share a
# network — it keeps credentials off the public internet and avoids egress cost.
# Managed Postgres usually needs ?sslmode=require on an external URL.

# Generate each separately — never reuse a development value, and never reuse one
# secret for both:
#   openssl rand -base64 48
# Minimum 32 characters, and config.js rejects the .env.example placeholders
# outright, so a copy-paste of the dev file fails the boot rather than shipping.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Comma-separated allow-list of frontend origins. Never a wildcard: CORS runs
# with credentials, so a reflected origin is a real hole. Include every domain
# that serves the app, staging and preview URLs included.
CORS_ORIGIN=https://app.example.com

# ── Cookie scope — read the note, this is the usual production bug ───────────

# The refresh cookie is sameSite=strict. If the frontend and API sit on
# different registrable domains, the browser drops it on every request and users
# appear to log in then instantly log out.
#
# Two working shapes:
#   1. Proxy /api/* through the frontend domain (see frontend/vercel.json).
#      Leave COOKIE_DOMAIN unset — everything is same-origin.
#   2. Subdomains of one parent (app.example.com + api.example.com):
#      set COOKIE_DOMAIN=.example.com so the cookie is shared.
# COOKIE_DOMAIN=.example.com

# ── Optional, with defaults ──────────────────────────────────────────────────

PORT=4000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
JSON_BODY_LIMIT=1mb

# ── File storage (S3 / Cloudflare R2) ────────────────────────────────────────
#
# Uploads stay disabled until BUCKET, REGION, ACCESS_KEY_ID and
# SECRET_ACCESS_KEY are ALL set — half-configured storage fails at the moment a
# user uploads rather than at boot, so it is treated as unconfigured.
#
# With these unset, documents are written to /app/uploads on local disk. On any
# containerised or multi-instance host that means files vanish on redeploy and
# are not shared between instances. Configure this before going live.
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2 only — the account-specific API endpoint. Leave unset for plain AWS S3.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Where files are SERVED from, which is not where you upload to. Required for
# R2; for plain S3 it defaults to the virtual-hosted bucket URL.
# S3_PUBLIC_BASE_URL=https://files.example.com
S3_PRESIGN_TTL_SECONDS=300

# ── Password reset email ─────────────────────────────────────────────────────
#
# Unset means reset links are written to the logs instead of sent. That is fine
# in development and a silent dead end in production — password reset simply
# will not work for users.
APP_URL=https://app.example.com
# Where reset links point. Defaults to the first CORS_ORIGIN if unset.
MAIL_PROVIDER=resend
MAIL_API_KEY=
MAIL_FROM=noreply@example.com
# MAIL_FROM must be on a domain you have verified with the provider, or every
# send is rejected.

# ── Rate limiting ────────────────────────────────────────────────────────────
#
# Unset = in-memory counters, correct for exactly one instance. With more than
# one, each process counts separately (so the real limit is N x 20 per 15 min)
# and a restart clears the window. Set this only when running multiple instances.
# REDIS_URL=redis://default:password@host:6379
